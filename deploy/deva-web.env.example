# Deva Web 环境变量样例(web-migration-plan.md §11.1)。
# 复制到 /etc/deva/deva-web.env 并填入真实值(root:root 0600);占位符不替换应用会拒绝启动。

# 必填:访问令牌。生成:openssl rand -hex 32;不写入仓库,不进日志。
DEVA_WEB_TOKEN=__REPLACE_WITH_openssl_rand_hex_32__

# 必填:完整对外 Origin(scheme://host[:port],无路径/查询串),须与 nginx server_name 一致。
DEVA_WEB_ORIGIN=https://deva.example.com

# 监听地址/端口:生产仅回环,由 nginx 反代。
DEVA_WEB_HOST=127.0.0.1
DEVA_WEB_PORT=7421

# 数据根目录(必须可读写、独占;配置/密钥/会话/技能/任务都在其下)。
DEVA_HOME=/var/lib/deva

# 可选:64 位 hex 主密钥;为空则用 DEVA_HOME/secret.key(首启自动生成,0600)。
# 备份数据目录时必须连主密钥一起备份;不设置则删除本行注释
#DEVA_SECRET_KEY=

# 可选:信任代理(仅当按 deploy/nginx.conf 单层本机 nginx 部署时设 1)。
#DEVA_TRUST_PROXY=1

# 可选:迁移演练/测试设为 0(禁自动调度与自动外连;手动触发不受影响)。
#DEVA_AUTOSTART=0
